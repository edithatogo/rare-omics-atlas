# Never commit downloaded or processed patient datasets
/data/raw/
/data/processed/
/data/derived/
/results/
/.cache/
/.venv/
/.Rproj.user/
/Manifest-local.toml

# Medallion layers remain local until a separately reviewed artifact release
/data/bronze/
/data/silver/
/data/gold/
/data/reference-cache/

# Native build products and operational caches
**/target/
**/__pycache__/
*.pyc
**/.venv/
/.tools/
/artifacts/
/.coverage*
/.env
/.env.*
!/.env.example
